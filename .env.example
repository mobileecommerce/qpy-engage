# Public Meta application identifiers
META_APP_ID=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_GRAPH_VERSION=v25.0

# Secrets: configure only in the hosting environment; never commit real values
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_TOKEN_ENCRYPTION_KEY=

# Authentication: no extra secret required. Signup/login use PBKDF2 password
# hashing and per-user session tokens stored in D1 (see worker/auth.ts).
